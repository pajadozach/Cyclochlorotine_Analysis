integrator = md
dt = 0.002
nsteps = 50000    ; 0.1 ns
nstxout = 5000
nstvout = 5000
nstenergy = 1000
nstlog = 1000
continuation = no
constraint_algorithm = lincs
constraints = all-bonds
tcoupl = V-rescale
tc-grps = Protein LIG SOL
tau_t = 0.1 0.1 0.1
ref_t = 300 300 300
pcoupl = no
pbc = xyz
cutoff-scheme = Verlet
coulombtype = PME
rcoulomb = 1.0
rvdw = 1.0
