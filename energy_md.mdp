title = Production
integrator = md
dt = 0.002
nsteps = 0        ; 50 ns
nstxout-compressed = 5000
nstenergy = 1
nstlog = 1000
continuation = yes
constraint_algorithm = lincs
constraints = h-bonds
cutoff-scheme = Verlet
coulombtype = PME
rcoulomb = 1.0
rvdw = 1.0
tcoupl = V-rescale
